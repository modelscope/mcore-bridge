+def test_copy_tensor_model_parallel_attributes_mirrors_allreduce():
+    """fp32 master copies must keep the `allreduce` flag that marks expert parameters.
+
+    param_is_not_tensor_parallel_duplicate switches duplicate filtering to the expert TP group
+    based on that flag. Losing it on the float16/distributed optimizer clones makes expert shards
+    deduplicate over the attention TP group instead, and since the expert grad-stats group does not
+    span attention TP, each rank then clips with a different coefficient.
+    """
+    expert = torch.nn.Parameter(torch.ones(1))
+    expert.allreduce = False
+    expert_copy = torch.nn.Parameter(torch.ones(1))
+
+    copy_tensor_model_parallel_attributes(expert_copy, expert)
+
+    assert expert_copy.allreduce is False
+
+    # `allreduce` is deliberately absent from _MODEL_PARALLEL_ATTRIBUTE_DEFAULTS: a default there
+    # would tag every parameter. Only an explicit source flag is mirrored.
+    plain = torch.nn.Parameter(torch.ones(1))
+    plain_copy = torch.nn.Parameter(torch.ones(1))
+
+    copy_tensor_model_parallel_attributes(plain_copy, plain)
+
+    assert not hasattr(plain_copy, "allreduce")
+
+
